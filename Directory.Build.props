<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      NU1903 stays a warning rather than an error. It flags CVE-2025-6965 in the
      transitive native package SQLitePCLRaw.lib.e_sqlite3 (pulled in by EF Core
      Sqlite). The 2.1.x line has no patched release; the fix only ships in the
      3.x bundle, which EF Core 8/10 do not support. The bug needs
      attacker-controlled SQL, which a local-first tool with a local database
      does not expose. Keep it visible so we can drop this once EF Core ships a
      3.x-compatible bundle.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>

    <!-- Single source of truth for the AgentRecall version. -->
    <VersionPrefix>0.7.0</VersionPrefix>

    <!-- Only the CLI project opts back in (as a packed tool). -->
    <IsPackable>false</IsPackable>

    <!--
      Deterministic, reproducible builds. The compiler is deterministic by default,
      but the published package is only flagged "deterministic" when source paths are
      normalized via ContinuousIntegrationBuild. Enable that only in CI (GitHub Actions
      sets CI=true) so local builds keep real paths for debugging, while the released
      NuGet package is reproducible. Source Link maps embedded paths back to GitHub.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Dependency versions are chosen per target framework so the tool installs on
    machines without the .NET 10 SDK. net8.0 (LTS) uses the 8.0.x stack; net10.0
    uses the 10.0.x stack. Referencing projects pull these via $(EfCoreVersion) /
    $(ExtensionsVersion) instead of hard-coding a version.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <EfCoreVersion>8.0.0</EfCoreVersion>
    <ExtensionsVersion>8.0.0</ExtensionsVersion>
    <!-- Patched Caching.Memory (8.0.1) requires DI.Abstractions >= 8.0.2. -->
    <DiAbstractionsVersion>8.0.2</DiAbstractionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <EfCoreVersion>10.0.9</EfCoreVersion>
    <ExtensionsVersion>10.0.9</ExtensionsVersion>
    <DiAbstractionsVersion>10.0.9</DiAbstractionsVersion>
  </PropertyGroup>
</Project>
