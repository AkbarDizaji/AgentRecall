<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentRecall.Core\AgentRecall.Core.csproj" />
    <ProjectReference Include="..\AgentRecall.Infrastructure\AgentRecall.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(ExtensionsVersion)" />
    <!-- Patched SQLite native bundle; overrides EF Core's transitive 2.1.x (see Directory.Build.props). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlitePclRawVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentRecall.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentrecall.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentrecall</AssemblyName>
    <RootNamespace>AgentRecall.Cli</RootNamespace>
  </PropertyGroup>

  <!-- .NET global tool packaging. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentrecall</ToolCommandName>
    <PackageId>AgentRecall</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>

    <Title>AgentRecall</Title>
    <Authors>Akbar Dizaji</Authors>
    <Description>A local-first memory and learning system for AI coding agents, with an MCP server for Claude Code.</Description>
    <PackageTags>mcp;ai;agents;claude;memory;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/AkbarDizaji/AgentRecall</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkbarDizaji/AgentRecall</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.1.0 adds standing (always-apply) rules: universal constraints — style, tone, process, and quality rules such as "don't leave unnecessary comments" — are now injected on every task instead of only when they match by keyword relevance, fixing the case where such a rule was captured correctly yet never surfaced. `AlwaysApply` is orthogonal to `ScopeLevel` (how a rule is delivered, not where it is true). Standing rules bypass the relevance floor and are delivered as a small, capped (5), high-salience must-follow band; universality is classified at capture time (the judge flags it, preferences are standing by nature, and a repeated correction promotes a rule as a backstop), so one correction is enough. Contextual and project-scoped rules are unchanged. Full notes: https://github.com/AkbarDizaji/AgentRecall/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
