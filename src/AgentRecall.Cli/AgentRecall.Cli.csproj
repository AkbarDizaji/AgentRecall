<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentRecall.Core\AgentRecall.Core.csproj" />
    <ProjectReference Include="..\AgentRecall.Infrastructure\AgentRecall.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(ExtensionsVersion)" />
    <!-- Patched SQLite native bundle; overrides EF Core's transitive 2.1.x (see Directory.Build.props). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlitePclRawVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentRecall.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentrecall.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentrecall</AssemblyName>
    <RootNamespace>AgentRecall.Cli</RootNamespace>
  </PropertyGroup>

  <!-- .NET global tool packaging. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentrecall</ToolCommandName>
    <PackageId>AgentRecall</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>

    <Title>AgentRecall</Title>
    <Authors>Akbar Dizaji</Authors>
    <Description>A local-first memory and learning system for AI coding agents, with an MCP server for Claude Code.</Description>
    <PackageTags>mcp;ai;agents;claude;memory;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/AkbarDizaji/AgentRecall</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkbarDizaji/AgentRecall</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.2.0 adds opt-in built-in seed packs: curated starter rules that give an agent useful engineering instincts before a project has learned its own memory. The first pack, `tidy-first`, ships ten paraphrased conditional refactoring rules (no copied book text). Install a pack with `agentrecall seed install tidy-first` (Active from day one at moderate confidence; `--suggested` keeps them Pending for manual approval), and manage them with `seed list|show|status|remove`. Seed rules are marked seed-derived, rank below project-specific rules, never overwrite your own rules, and evolve their confidence like any rule. Full notes: https://github.com/AkbarDizaji/AgentRecall/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
