<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentRecall.Core\AgentRecall.Core.csproj" />
    <ProjectReference Include="..\AgentRecall.Infrastructure\AgentRecall.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(ExtensionsVersion)" />
    <!-- Patched SQLite native bundle; overrides EF Core's transitive 2.1.x (see Directory.Build.props). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlitePclRawVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentRecall.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentrecall.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentrecall</AssemblyName>
    <RootNamespace>AgentRecall.Cli</RootNamespace>
  </PropertyGroup>

  <!-- .NET global tool packaging. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentrecall</ToolCommandName>
    <PackageId>AgentRecall</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>

    <Title>AgentRecall</Title>
    <Authors>Akbar Dizaji</Authors>
    <Description>A local-first memory and learning system for AI coding agents, with an MCP server for Claude Code.</Description>
    <PackageTags>mcp;ai;agents;claude;memory;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/AkbarDizaji/AgentRecall</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkbarDizaji/AgentRecall</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.2.0 adds a PreToolUse recall hook: rules are now injected at the moment a file is written, keyed on the file's path and the code being written, not only on the turn's opening prompt. This closes the gap where a high-level request (e.g. "implement login feature") carries no signal that a matching file is coming, so a convention scoped to that file never surfaced through prompt-time recall alone. The hook is deterministic (run by Claude Code, not left to the model to call a tool), scoped to the file-mutating tools (Edit, Write, MultiEdit) via a matcher, and injects nothing when no rule is relevant to the file. `agentrecall devcontainer init` now wires the hook automatically alongside the existing UserPromptSubmit and Stop hooks. Full notes: https://github.com/AkbarDizaji/AgentRecall/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
