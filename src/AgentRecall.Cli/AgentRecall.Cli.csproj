<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentRecall.Core\AgentRecall.Core.csproj" />
    <ProjectReference Include="..\AgentRecall.Infrastructure\AgentRecall.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(ExtensionsVersion)" />
    <!-- Patched SQLite native bundle; overrides EF Core's transitive 2.1.x (see Directory.Build.props). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlitePclRawVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentRecall.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentrecall.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentrecall</AssemblyName>
    <RootNamespace>AgentRecall.Cli</RootNamespace>
  </PropertyGroup>

  <!-- .NET global tool packaging. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentrecall</ToolCommandName>
    <PackageId>AgentRecall</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>

    <Title>AgentRecall</Title>
    <Authors>Akbar Dizaji</Authors>
    <Description>A local-first memory and learning system for AI coding agents, with an MCP server for Claude Code.</Description>
    <PackageTags>mcp;ai;agents;claude;memory;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/AkbarDizaji/AgentRecall</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkbarDizaji/AgentRecall</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.2.1 hardens the 2.2.0 PreToolUse recall hook. File- and directory-scoped rules are now rewarded when the file being written is within their scope (previously they scored below a global rule and never surfaced). The hook's turn id is derived from the turn's prompt like the other hooks, so its retrievals join the end-of-turn summary. Rules already surfaced earlier in a turn are no longer re-injected or re-counted as used on every subsequent write. The database uses a busy command timeout and WAL so concurrent hook processes retry instead of silently dropping a write on SQLITE_BUSY. And the "fetched N rules" status line moved from the model's context to the user-facing systemMessage channel. Full notes: https://github.com/AkbarDizaji/AgentRecall/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
