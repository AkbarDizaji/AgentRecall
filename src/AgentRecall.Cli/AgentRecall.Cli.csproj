<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentRecall.Core\AgentRecall.Core.csproj" />
    <ProjectReference Include="..\AgentRecall.Infrastructure\AgentRecall.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentrecall.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentrecall</AssemblyName>
    <RootNamespace>AgentRecall.Cli</RootNamespace>
  </PropertyGroup>

  <!-- .NET global tool packaging. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentrecall</ToolCommandName>
    <PackageId>AgentRecall</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>

    <Title>AgentRecall</Title>
    <Authors>Akbar Dizaji</Authors>
    <Description>A local-first memory and learning system for AI coding agents, with an MCP server for Claude Code.</Description>
    <PackageTags>mcp;ai;agents;claude;memory;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/AkbarDizaji/AgentRecall</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkbarDizaji/AgentRecall</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.2.3 adds `agentrecall devcontainer init`, which scaffolds dev container wiring so the tool reinstalls automatically on every "Rebuild Container" (reinstall from NuGet, persisted database volume, MCP re-registration). Full notes: https://github.com/AkbarDizaji/AgentRecall/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
